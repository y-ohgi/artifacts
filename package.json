{
  "name": "artifacts",
  "version": "0.1.0",
  "description": "Claude Codeが生成したHTMLアーティファクトをアップロードして閲覧するサイト",
  "private": true,
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-ohgi/artifacts.git"
  },
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --env dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env dev",
    "migrate:local": "wrangler d1 migrations apply artifacts-meta-dev --env dev --local",
    "migrate:remote": "wrangler d1 migrations apply artifacts-meta-dev --env dev --remote"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
